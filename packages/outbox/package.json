{
  "name": "@enrouta/outbox",
  "version": "0.1.0",
  "description": "Framework-agnostic offline send queue: persist, retry, and classify failed submissions. Bring your own storage and transport.",
  "license": "MIT",
  "author": "EnRouta <info@enrouta.com>",
  "keywords": [
    "outbox",
    "offline",
    "queue",
    "retry",
    "sync",
    "resilience"
  ],
  "homepage": "https://github.com/enrouta/atlas/tree/main/packages/outbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enrouta/atlas.git",
    "directory": "packages/outbox"
  },
  "bugs": {
    "url": "https://github.com/enrouta/atlas/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
