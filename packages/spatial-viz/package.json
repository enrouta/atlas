{
  "name": "@enrouta/spatial-viz",
  "version": "0.1.0-beta.0",
  "description": "Framework-agnostic helpers to turn EnRouta risk cells into GeoJSON for map rendering.",
  "license": "MIT",
  "author": "EnRouta <info@enrouta.com>",
  "keywords": [
    "enrouta",
    "h3",
    "geojson",
    "spatial",
    "map",
    "visualization",
    "risk"
  ],
  "homepage": "https://github.com/enrouta/atlas/tree/main/packages/spatial-viz#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enrouta/atlas.git",
    "directory": "packages/spatial-viz"
  },
  "bugs": {
    "url": "https://github.com/enrouta/atlas/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enrouta/types": "workspace:^",
    "@types/geojson": "^7946.0.14",
    "h3-js": "^4.4.0"
  }
}
