{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source packages for the EnRouta spatial-safety platform.",
  "license": "MIT",
  "author": "EnRouta <info@enrouta.com>",
  "homepage": "https://github.com/enrouta/atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enrouta/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/enrouta/atlas/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
